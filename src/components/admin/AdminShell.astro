---
import Layout from '../../layouts/Layout.astro';

interface Props {
  title: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, breadcrumbs = [] } = Astro.props;
const user = Astro.locals.user;
---

<Layout title={`${title} | Admin | Logistics Gurukul`}>
  <main class="min-h-screen bg-slate-50">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
      <div class="container mx-auto px-6 py-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <a
            href="/admin"
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors text-sm font-semibold shrink-0"
            aria-label="Back to Dashboard"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
            </svg>
            <span class="hidden sm:inline">Back</span>
          </a>
          <nav class="flex items-center gap-2 text-sm min-w-0 overflow-hidden">
            <a href="/admin" class="text-blue-600 font-black tracking-tight whitespace-nowrap">Logistics Gurukul</a>
            <span class="text-slate-300">/</span>
            <a href="/admin" class="text-slate-700 font-semibold hover:text-blue-600 whitespace-nowrap">Admin</a>
            {breadcrumbs.map((b) => (
              <>
                <span class="text-slate-300">/</span>
                {b.href ? (
                  <a href={b.href} class="text-slate-700 font-semibold hover:text-blue-600 truncate">{b.label}</a>
                ) : (
                  <span class="text-slate-500 truncate">{b.label}</span>
                )}
              </>
            ))}
          </nav>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-slate-500 hidden md:inline">{user?.email}</span>
          <form method="POST" action="/api/admin/logout">
            <button type="submit" class="px-3 py-1.5 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-100 transition-colors text-sm font-semibold">
              Sign out
            </button>
          </form>
        </div>
      </div>
    </header>

    <div class="container mx-auto px-6 py-10">
      <slot />
    </div>
  </main>
</Layout>
