---
interface Props {
  job: any;
  previewMode?: boolean;
  applied?: boolean;
  applyError?: string | null;
}

const { job, previewMode = false, applied = false, applyError = null } = Astro.props;

const applyUrl = job.apply_url && String(job.apply_url).trim();

const asList = (arr: unknown): string[] =>
  Array.isArray(arr) ? arr.filter((x): x is string => typeof x === 'string' && x.trim().length > 0) : [];

const locations = asList(job.locations);
const responsibilities = asList(job.responsibilities);
const requirements = asList(job.requirements);
const locationDisplay = locations.length > 0 ? locations.join(', ') : (job.location ?? '');

function fmtDate(d: string | null): string {
  if (!d) return '';
  const dt = new Date(d);
  if (Number.isNaN(dt.getTime())) return '';
  return dt.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
}
---

<main class="bg-slate-50">
  {/* Dark hero */}
  <section class="relative bg-[#050505] text-white pt-32 pb-16 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/hero-bg-premium.png" alt="" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-br from-blue-900/30 via-slate-900/60 to-[#050505]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#050505]"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10 max-w-6xl">
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8">
        <a href="/" class="hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10" />
          </svg>
        </a>
        <span class="text-slate-600">›</span>
        <a href="/placements" class="hover:text-white transition-colors">Careers</a>
        <span class="text-slate-600">›</span>
        <a href="/placements" class="hover:text-white transition-colors">Open Positions</a>
        <span class="text-slate-600">›</span>
        <span class="text-slate-300">Job Details</span>
      </nav>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-black font-heading leading-[1.05] tracking-tight mb-6 max-w-4xl">
        {job.title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 mb-8">
        {locationDisplay && (
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-200 text-sm backdrop-blur">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {job.location && locations.length > 0 ? job.location : locationDisplay}
          </span>
        )}
        {job.experience && (
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-200 text-sm backdrop-blur">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.93 23.93 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {job.experience}
          </span>
        )}
        {job.employment_type && (
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-200 text-sm backdrop-blur">
            {job.employment_type}
          </span>
        )}
        {job.apply_deadline && (
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-400/30 text-amber-200 text-sm backdrop-blur">
            Apply by {fmtDate(job.apply_deadline)}
          </span>
        )}
      </div>

      <div class="flex items-center gap-3">
        <a href="#apply" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-slate-900 hover:bg-slate-100 font-bold text-sm transition-colors shadow-lg">
          Apply Now
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <button id="share-btn" type="button" aria-label="Share this job" title="Share"
          class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 text-white transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m9.032 4.026a9.003 9.003 0 01-9.032-4.026m9.032 4.026A3 3 0 1115.316 18m1.368-2.658c.18.398.316.852.316 1.342m-1.684-1.342L8.684 9.658M16.658 6.342L8.684 10.658" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-6 max-w-6xl py-12 lg:py-16">
    <div class="grid lg:grid-cols-[1fr_420px] gap-10 items-start">
      <div class="space-y-10 text-slate-700 leading-relaxed">
        {locations.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold text-slate-900 mb-3 font-heading">Locations</h2>
            <p class="text-base">{locations.join(', ')}</p>
          </section>
        )}

        {responsibilities.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold text-slate-900 mb-3 font-heading">Responsibilities</h2>
            <ul class="list-disc pl-6 space-y-2">
              {responsibilities.map((item) => <li class="leading-relaxed">{item}</li>)}
            </ul>
          </section>
        )}

        {requirements.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold text-slate-900 mb-3 font-heading">Requirements</h2>
            <ul class="list-disc pl-6 space-y-2">
              {requirements.map((item) => <li class="leading-relaxed">{item}</li>)}
            </ul>
          </section>
        )}

        {job.description && (
          <section
            class="job-content
                   [&>p]:mb-5 [&>p]:text-base
                   [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-slate-900 [&>h2]:mb-4 [&>h2]:mt-10 [&>h2]:font-heading
                   [&>h3]:text-xl [&>h3]:font-bold [&>h3]:text-slate-900 [&>h3]:mb-3 [&>h3]:mt-8 [&>h3]:font-heading
                   [&>h4]:text-lg [&>h4]:font-bold [&>h4]:text-slate-900 [&>h4]:mb-2 [&>h4]:mt-6 [&>h4]:font-heading
                   [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:mb-5 [&>ul>li]:mb-2 [&>ul>li]:leading-relaxed
                   [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:mb-5 [&>ol>li]:mb-2
                   [&_a]:text-blue-600 [&_a]:underline hover:[&_a]:text-blue-800
                   [&_strong]:text-slate-900 [&_strong]:font-bold"
            set:html={job.description}
          />
        )}

        {locations.length === 0 && responsibilities.length === 0 && requirements.length === 0 && !job.description && (
          <p class="text-slate-500 italic">No description has been added for this opening yet.</p>
        )}
      </div>

      <aside id="apply" class="lg:sticky lg:top-32">
        <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-7 shadow-2xl border border-slate-800">
          <h2 class="text-xl font-bold mb-1">Apply for {job.title}</h2>
          <p class="text-slate-400 text-sm mb-6">All fields marked * are required.</p>

          {previewMode && (
            <div class="mb-5 p-4 rounded-lg bg-amber-500/10 border border-amber-400/30 text-amber-200 text-xs font-semibold">
              Preview mode — form submissions are disabled.
            </div>
          )}
          {applied && (
            <div class="mb-5 p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-200 text-sm font-semibold">
              Thanks — your application was received. We'll be in touch.
            </div>
          )}
          {applyError && (
            <div class="mb-5 p-4 rounded-lg bg-red-500/10 border border-red-500/30 text-red-200 text-sm">{applyError}</div>
          )}

          {applyUrl ? (
            <>
              <p class="text-slate-300 text-sm mb-5">This role uses an external application portal.</p>
              <a href={previewMode ? '#' : applyUrl} target={previewMode ? undefined : '_blank'} rel={previewMode ? undefined : 'noopener noreferrer'}
                aria-disabled={previewMode}
                class:list={["block text-center px-6 py-3 bg-white text-slate-900 font-bold rounded-full text-sm transition-colors", previewMode ? "opacity-60 cursor-not-allowed" : "hover:bg-slate-100"]}>
                Apply on external site
              </a>
            </>
          ) : (
            <form id="apply-form" method="POST" action="/api/placements/apply" enctype="multipart/form-data" class="space-y-4">
              <input type="hidden" name="job_slug" value={job.slug} />
              <div class="hidden" aria-hidden="true">
                <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1.5" for="ap-first">First Name *</label>
                  <input id="ap-first" name="first_name" type="text" required={!previewMode} disabled={previewMode} maxlength="80"
                    placeholder="Enter your first name"
                    class="w-full px-3.5 py-2.5 bg-slate-950/50 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:opacity-60" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1.5" for="ap-last">Last Name *</label>
                  <input id="ap-last" name="last_name" type="text" required={!previewMode} disabled={previewMode} maxlength="80"
                    placeholder="Enter your last name"
                    class="w-full px-3.5 py-2.5 bg-slate-950/50 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:opacity-60" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5" for="ap-email">Email *</label>
                <input id="ap-email" name="email" type="email" required={!previewMode} disabled={previewMode} maxlength="200"
                  placeholder="john@abc.com"
                  class="w-full px-3.5 py-2.5 bg-slate-950/50 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:opacity-60" />
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5" for="ap-phone">Contact Number</label>
                <input id="ap-phone" name="phone" type="tel" maxlength="40" disabled={previewMode}
                  placeholder="+91 00000-00000"
                  class="w-full px-3.5 py-2.5 bg-slate-950/50 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:opacity-60" />
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1.5" for="ap-loc">Preferred Location</label>
                  <input id="ap-loc" name="preferred_location" type="text" maxlength="80" disabled={previewMode}
                    placeholder="e.g. Kochi"
                    class="w-full px-3.5 py-2.5 bg-slate-950/50 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:opacity-60" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1.5">Total Experience</label>
                  <div class="grid grid-cols-2 gap-2">
                    <input id="ap-exp-y" name="experience_years" type="number" min="0" max="50" placeholder="Year" disabled={previewMode}
                      class="w-full px-3 py-2.5 bg-slate-950/50 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:opacity-60" />
                    <input id="ap-exp-m" name="experience_months" type="number" min="0" max="11" placeholder="Month" disabled={previewMode}
                      class="w-full px-3 py-2.5 bg-slate-950/50 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:opacity-60" />
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Resume * <span class="font-normal text-slate-500">— PDF, max 5 MB</span></label>
                <label id="ap-cv-drop" for="ap-cv"
                  class:list={["block rounded-lg border-2 border-dashed border-slate-700 bg-slate-950/30 transition-colors p-6 text-center", previewMode ? "opacity-60 cursor-not-allowed" : "cursor-pointer hover:bg-slate-950/50 hover:border-slate-600"]}>
                  <svg class="w-8 h-8 mx-auto text-slate-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  <p class="text-sm text-slate-300"><span class="font-semibold">Drag &amp; Drop</span> your resume or <span class="text-blue-400 underline">Browse files</span></p>
                  <p id="ap-cv-name" class="text-xs text-slate-400 mt-1.5 truncate"></p>
                </label>
                <input id="ap-cv" name="cv" type="file" accept="application/pdf,.pdf" required={!previewMode} disabled={previewMode} class="sr-only" />
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5" for="ap-note">Message to Hiring Manager</label>
                <textarea id="ap-note" name="cover_note" rows="3" maxlength="2000" disabled={previewMode}
                  placeholder="Type your cover letter or message"
                  class="w-full px-3.5 py-2.5 bg-slate-950/50 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:opacity-60"></textarea>
              </div>

              <button type="submit" disabled={previewMode}
                class:list={["w-full py-3 text-white font-bold rounded-full text-sm transition-colors shadow-lg shadow-blue-600/30 mt-2", previewMode ? "bg-blue-600/40 cursor-not-allowed" : "bg-blue-600 hover:bg-blue-700"]}>
                {previewMode ? 'Submission disabled in preview' : 'Submit Application'}
              </button>
              <p class="text-[11px] text-slate-500 leading-relaxed">By submitting you consent to us storing this CV for recruiting purposes.</p>
            </form>
          )}
        </div>
      </aside>
    </div>
  </section>
</main>

<script>
  const drop = document.getElementById('ap-cv-drop');
  const input = document.getElementById('ap-cv') as HTMLInputElement | null;
  const nameEl = document.getElementById('ap-cv-name');
  if (drop && input && nameEl && !input.disabled) {
    const update = () => {
      const f = input.files?.[0];
      nameEl.textContent = f ? `Selected: ${f.name}` : '';
    };
    input.addEventListener('change', update);

    ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.add('border-blue-400', 'bg-slate-950/60');
    }));
    ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.remove('border-blue-400', 'bg-slate-950/60');
    }));
    drop.addEventListener('drop', (e: DragEvent) => {
      const f = e.dataTransfer?.files?.[0];
      if (f) {
        const dt = new DataTransfer();
        dt.items.add(f);
        input.files = dt.files;
        update();
      }
    });
  }

  const shareBtn = document.getElementById('share-btn');
  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    const title = document.title;
    if (navigator.share) {
      try { await navigator.share({ title, url }); return; } catch {}
    }
    try {
      await navigator.clipboard.writeText(url);
      shareBtn.setAttribute('title', 'Link copied');
    } catch {
      window.prompt('Copy this link:', url);
    }
  });
</script>
