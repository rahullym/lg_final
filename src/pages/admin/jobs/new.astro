---
export const prerender = false;

import AdminShell from '../../../components/admin/AdminShell.astro';
import RichTextEditor from '../../../components/admin/RichTextEditor';

const url = new URL(Astro.request.url);
const error = url.searchParams.get('error');
---

<AdminShell title="New Opening" breadcrumbs={[{ label: 'Placements', href: '/admin/jobs' }, { label: 'New' }]}>
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold text-slate-900 mb-1">New Opening</h1>
    <p class="text-slate-600 text-sm mb-8">Add a job opening. Save as draft to keep it off the public page.</p>

    {error && <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">{error}</div>}

    <form
      method="POST"
      action="/api/admin/jobs"
      enctype="multipart/form-data"
      class="bg-white rounded-2xl border border-slate-200 p-8 space-y-6"
    >
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="title">Title *</label>
        <input id="title" name="title" type="text" required maxlength="200"
          placeholder="e.g. Logistics Operations Executive"
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="slug">Slug</label>
        <input id="slug" name="slug" type="text" pattern="[a-z0-9-]*"
          placeholder="auto-generated from title"
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 font-mono" />
        <p class="text-xs text-slate-500 mt-1">Lowercase letters, numbers, and hyphens only.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="department">Department</label>
          <input id="department" name="department" type="text"
            placeholder="e.g. Operations, Sales, Training"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="location">Primary Location</label>
          <input id="location" name="location" type="text"
            placeholder="e.g. Kochi, or Multiple Cities"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
          <p class="text-xs text-slate-500 mt-1">Shown in listings and the chip at the top.</p>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="locations">Locations</label>
        <textarea id="locations" name="locations" rows="4"
          placeholder={'India - Trivandrum\nIndia - Cochin\nIndia - Calicut'}
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm font-mono focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"></textarea>
        <p class="text-xs text-slate-500 mt-1">One location per line. Shown as the "Locations" block on the public page.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="employment_type">Employment Type</label>
          <select id="employment_type" name="employment_type"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm bg-white focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
            <option value="">Select…</option>
            <option value="Full-time">Full-time</option>
            <option value="Part-time">Part-time</option>
            <option value="Internship">Internship</option>
            <option value="Contract">Contract</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="experience">Experience</label>
          <input id="experience" name="experience" type="text"
            placeholder="e.g. 0–2 years"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="apply_deadline">Apply Deadline</label>
          <input id="apply_deadline" name="apply_deadline" type="date"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="order">Display Order</label>
          <input id="order" name="order" type="number" value="0"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
          <p class="text-xs text-slate-500 mt-1">Lower numbers show first.</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="apply_email">Apply Email</label>
          <input id="apply_email" name="apply_email" type="email"
            placeholder="careers@logisticsgurukul.com"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
          <p class="text-xs text-slate-500 mt-1">Candidates will email their CV here.</p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="apply_url">External Apply URL</label>
          <input id="apply_url" name="apply_url" type="url"
            placeholder="https://… (optional)"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
          <p class="text-xs text-slate-500 mt-1">If set, the Apply button links here instead of email.</p>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="responsibilities">Responsibilities</label>
        <textarea id="responsibilities" name="responsibilities" rows="6"
          placeholder={'Design, develop, and execute test scripts\nAnalyze system performance under load\nWork closely with development teams'}
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"></textarea>
        <p class="text-xs text-slate-500 mt-1">One responsibility per line. Rendered as a bulleted list.</p>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="requirements">Requirements</label>
        <textarea id="requirements" name="requirements" rows="6"
          placeholder={'4–8 years of experience\nStrong hands-on experience with X\nDegree in a related field'}
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"></textarea>
        <p class="text-xs text-slate-500 mt-1">One requirement per line. Rendered as a bulleted list.</p>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Overview / Description</label>
        <RichTextEditor client:load name="description" placeholder="Optional intro paragraph or extra details shown above the lists." />
        <p class="text-xs text-slate-500 mt-1">Optional rich-text intro. The structured lists above appear below it.</p>
      </div>

      <div class="flex items-center gap-3 p-4 rounded-lg bg-slate-50 border border-slate-200">
        <input id="draft" name="draft" type="checkbox" class="w-4 h-4" />
        <label for="draft" class="text-sm font-semibold text-slate-700">Save as draft (not publicly visible)</label>
      </div>

      <div class="flex items-center justify-between pt-2 border-t border-slate-100">
        <a href="/admin/jobs" class="text-sm text-slate-600 hover:text-slate-900 font-semibold">Cancel</a>
        <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-sm transition-colors">
          Create Opening
        </button>
      </div>
    </form>

    <script>
      const titleEl = document.getElementById('title') as HTMLInputElement | null;
      const slugEl = document.getElementById('slug') as HTMLInputElement | null;
      let touched = false;
      slugEl?.addEventListener('input', () => { touched = true; });
      titleEl?.addEventListener('input', () => {
        if (touched || !slugEl) return;
        slugEl.value = titleEl.value
          .toLowerCase().trim()
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
      });
    </script>
  </div>
</AdminShell>
