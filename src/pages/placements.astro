---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";
import ContactCTA from "../components/ContactCTA";
import { supabase } from "../lib/supabase";

const { data: rows } = await supabase
  .from("jobs")
  .select('id, slug, title, department, location, employment_type, experience, apply_deadline, "order", updated_at')
  .eq("draft", false)
  .order("order", { ascending: true })
  .order("updated_at", { ascending: false });

type Job = {
  id: string;
  slug: string;
  title: string;
  department: string | null;
  location: string | null;
  employment_type: string | null;
  experience: string | null;
  apply_deadline: string | null;
};

const jobs: Job[] = (rows ?? []) as Job[];

// Group by department for qburst-style layout. Jobs without a department fall under "Other".
const groups = new Map<string, Job[]>();
for (const job of jobs) {
  const key = job.department?.trim() || "Other";
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(job);
}
const departments = Array.from(groups.keys()).sort();

function fmtDate(d: string | null): string {
  if (!d) return "";
  const dt = new Date(d);
  if (Number.isNaN(dt.getTime())) return "";
  return dt.toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });
}
---

<Layout
  title="Placements & Careers | Logistics Gurukul"
  description="Open positions at Logistics Gurukul — join our team in logistics, supply chain, training, and operations."
>
  <Navbar client:load />

  <main>
    {/* Hero */}
    <section class="relative min-h-[40vh] flex items-center justify-center bg-[#050505] overflow-hidden pt-32">
      <div class="absolute inset-0 z-0">
        <img src="/hero-bg-premium.png" alt="" class="w-full h-full object-cover opacity-60" />
        <div class="absolute inset-0 bg-blue-900/20 mix-blend-overlay"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-[#050505]"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10 text-center">
        <span class="inline-block py-1 px-3 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-sm font-bold tracking-widest mb-6 uppercase backdrop-blur-sm">
          Careers
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 font-heading tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-400 to-white">Placements</span> & Openings
        </h1>
        <p class="text-slate-300 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          Build your career with us. Browse current openings across departments.
        </p>
      </div>
    </section>

    {/* Listings */}
    <section class="py-16 lg:py-20 bg-slate-50 min-h-[60vh]">
      <div class="container mx-auto px-6 max-w-5xl">
        {jobs.length === 0 && (
          <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center">
            <p class="text-slate-600 text-lg mb-4">No openings at the moment.</p>
            <p class="text-slate-500 text-sm">
              You can still <a href="/placements/submit-cv" class="text-blue-600 font-semibold hover:underline">submit your CV</a> and we'll reach out when a relevant role opens up.
            </p>
          </div>
        )}

        {jobs.length > 0 && (
          <div class="space-y-12">
            {departments.map((dept) => {
              const list = groups.get(dept)!;
              return (
                <div>
                  <div class="flex items-baseline justify-between mb-4 pb-3 border-b border-slate-200">
                    <h2 class="text-2xl font-bold text-slate-900 font-heading">{dept}</h2>
                    <span class="text-sm text-slate-500 font-semibold">
                      {list.length} opening{list.length === 1 ? '' : 's'}
                    </span>
                  </div>

                  <div class="space-y-3">
                    {list.map((job) => (
                      <a
                        href={`/placements/${job.slug}`}
                        class="group flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white rounded-xl border border-slate-200 p-5 hover:border-blue-300 hover:shadow-md transition-all"
                      >
                        <div class="flex-1 min-w-0">
                          <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                            {job.title}
                          </h3>
                          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-600 mt-1">
                            {job.location && <span>📍 {job.location}</span>}
                            {job.employment_type && <span>· {job.employment_type}</span>}
                            {job.experience && <span>· {job.experience}</span>}
                          </div>
                        </div>
                        <div class="flex items-center gap-4 shrink-0">
                          {job.apply_deadline && (
                            <span class="text-xs text-slate-500 font-semibold">
                              Apply by {fmtDate(job.apply_deadline)}
                            </span>
                          )}
                          <span class="inline-flex items-center gap-1 text-blue-600 font-semibold text-sm">
                            View
                            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                          </span>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        )}

        <div class="mt-16 bg-blue-50 border border-blue-100 rounded-2xl p-8 text-center">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Don't see a fit?</h3>
          <p class="text-slate-600 text-sm mb-4">
            Send your CV and we'll keep you in mind for upcoming roles.
          </p>
          <a
            href="/placements/submit-cv"
            class="inline-block px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-sm transition-colors shadow-lg shadow-blue-600/20"
          >
            Submit Your CV
          </a>
        </div>
      </div>
    </section>

    <div class="bg-white border-t border-slate-100">
      <ContactCTA client:visible />
    </div>
  </main>

  <Footer client:visible />
</Layout>
